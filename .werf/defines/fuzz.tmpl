# Fuzz image template for virtualization.
#
# Usage:
#   ---
#   {{- $_ := set . "FuzzEngine" "go" }}
#   {{- $_ := set . "FuzzWorkDir" (printf "/src/images/%s" .ImageName) }}
#   {{- $_ := set . "FuzzFromImage" (printf "%s%s" .ModuleNamePrefix .ImageName) }}
#   {{- $_ := set . "FuzzPackages" "./..." }}
#   {{- $_ := set . "FuzzTargetFiles" (list) }}
#   {{- include "fuzz image" . }}
#   → image {ModuleNamePrefix}{ImageName}-fuzz
# Put document separator "---" in werf.inc.yaml before include (not in this template).
#
# All five knobs are REQUIRED of every caller, the two empty-looking ones
# included. The dict is shared across the whole render, so a knob left unset
# does not fall back to a default — it keeps whatever the previously rendered
# fuzz image put there and silently builds the wrong base or copies a target
# file into a path this image does not have.
#
# FuzzFromImage is the Go build stage to sit on: it has to carry the sources and
# a resolvable module graph. dvcr-artifact, dvcr and virtualization-dra name
# their -builder stage; pvc-artifact, virtualization-artifact and virt-artifact
# name the build image itself. dvcr-artifact additionally needs CGO/libnbd and
# qemu-img; that stays keyed on the image name below, because it is derived and
# cannot leak between callers. Everything else is pure Go.
#
# Replay/list/run: `task fuzz:*`; task is installed outside the source module graph.
# Taskfile.fuzz.yml is copied into the selected fuzz workdir as Taskfile.yml.
{{- define "fuzz image" }}
{{- if eq (env "WERF_BUILD_FUZZ_IMAGES" "false") "true" }}
{{- $engine := required "fuzz image: FuzzEngine must be set by the caller" .FuzzEngine }}
{{- $prefix := .ModuleNamePrefix | default "" }}
{{- $fuzzWorkDir := required "fuzz image: FuzzWorkDir must be set by the caller" .FuzzWorkDir }}
{{- $isDVCR := eq .ImageName "dvcr-artifact" }}
{{- $fuzzFromImage := required "fuzz image: FuzzFromImage must be set by the caller" .FuzzFromImage }}
{{- $fuzzPackages := required "fuzz image: FuzzPackages must be set by the caller" .FuzzPackages }}
{{- $fuzzTargetFiles := required "fuzz image: FuzzTargetFiles must be set by the caller, empty list included" .FuzzTargetFiles }}
{{- $fuzzCGOEnabled := ternary "1" "0" $isDVCR }}
{{- $fuzzCGOCFlags := ternary "-std=gnu17" "" $isDVCR }}
image: {{ $prefix }}{{ .ImageName }}-fuzz
fromImage: {{ $fuzzFromImage }}
final: false
imageSpec:
  config:
    workingDir: {{ $fuzzWorkDir | quote }}
    labels:
      io.deckhouse.fuzz.engine: {{ $engine | quote }}
    env:
      # Filled during install (not via /go/pkg mount — that path is outside the image).
      GOMODCACHE: "/fuzz/gomod"
      CGO_ENABLED: {{ $fuzzCGOEnabled | quote }}
      CGO_CFLAGS: {{ $fuzzCGOCFlags | quote }}
      # Scope of `task fuzz:list`. The platform runs that task in this image, so
      # the narrowing an image needs has to travel with the image.
      FUZZ_PKGS: {{ $fuzzPackages | quote }}
git:
  - add: {{ .ModuleDir }}/Taskfile.fuzz.yml
    to: {{ $fuzzWorkDir }}/Taskfile.yml
    stageDependencies:
      install:
        - '**/*'
{{- /*
  FuzzTargetFiles places a fuzz target this repository owns into a source tree
  it does not: the dvcr and virt-artifact images sit on a fork cloned during the
  build, and a Go fuzz target has to live inside the package it tests. Each entry
  is {from: path in this repository, to: absolute path in the image}. Renaming
  the code under test in the fork then breaks this image's build, which is the
  intended failure mode -- louder than a target that stops covering anything.
*/}}
{{- range $fuzzTargetFiles }}
  - add: {{ $.ModuleDir }}/{{ .from }}
    to: {{ .to }}
    stageDependencies:
      install:
        - '**/*'
{{- end }}
{{- if $isDVCR }}
import:
  - image: {{ $prefix }}qemu
    add: /qemu-img
    to: /
    before: install
{{- end }}
mount:
{{ include "mount points for golang builds" . }}
secrets:
  - id: GOPROXY
    value: {{ .GOPROXY }}
  - id: CI_JOB_TOKEN
    value: "{{ env "CI_JOB_TOKEN" }}"
  - id: FUZZ_S3_ENDPOINT
    env: FUZZ_S3_ENDPOINT
  - id: FUZZ_S3_ACCESS_KEY
    env: FUZZ_S3_ACCESS_KEY
  - id: FUZZ_S3_SECRET_KEY
    env: FUZZ_S3_SECRET_KEY
  # Corpus layout: s3://anomaloys-materials/<repository>/<branch slug>/...
  # CI sets FUZZ_S3_BRANCH_SLUG=main for _dev (PR builds never publish corpus).
  - id: FUZZ_S3_REPOSITORY
    env: FUZZ_S3_REPOSITORY
  - id: FUZZ_S3_BRANCH_SLUG
    env: FUZZ_S3_BRANCH_SLUG
shell:
  install:
  - |
    set -eu
    # rebuild bump 2026-08-10T09:30
    export GOPROXY=$(cat /run/secrets/GOPROXY) CGO_ENABLED={{ $fuzzCGOEnabled }} GOOS=linux GOARCH=amd64
    export CGO_CFLAGS={{ $fuzzCGOCFlags | quote }}
    export CI_JOB_TOKEN=$(cat /run/secrets/CI_JOB_TOKEN)
    export GOPRIVATE="fox.flant.com/*"
    if [ -n "$CI_JOB_TOKEN" ]; then
      echo "machine fox.flant.com login gitlab-ci-token password $CI_JOB_TOKEN" > ~/.netrc
      chmod 600 ~/.netrc
    fi

    cd {{ $fuzzWorkDir | quote }}

    # git: go mod / go get need VCS; curl: download AWS CLI;
    # python3: k8s fuzz-compliance runner (fuzzctl); ca-certificates: TLS;
    # jq and AWS CLI: corpus restore during this build and S3 restore/upload in
    # the target Pod. ALT does not ship an awscli package, so only jq/unzip come
    # from the distro repository.
    # Prefer Deckhouse `pm` over apt-get: builder images often ship a stub apt-get
    # that does not understand --no-install-recommends.
    if ! command -v curl >/dev/null 2>&1 \
      || ! command -v git >/dev/null 2>&1 \
      || ! command -v python3 >/dev/null 2>&1 \
      || ! command -v jq >/dev/null 2>&1 \
      || ! command -v unzip >/dev/null 2>&1 \
      || ! command -v file >/dev/null 2>&1; then
      if command -v pm >/dev/null 2>&1; then
        # container-factory package is named "python" and installs python3.
        pm install git curl python ca-certificates jq unzip file
      elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache git curl python3 ca-certificates jq unzip file
      elif command -v apt-get >/dev/null 2>&1; then
        apt-get update -y
        apt-get install -y git curl python3 ca-certificates jq unzip file
      else
        echo "git, curl, python3, jq, unzip and file are required on the fuzz base image" >&2
        exit 1
      fi
    fi

    if ! command -v aws >/dev/null 2>&1; then
      AWS_CLI_DIR=/tmp/aws-cli-install
      rm -rf "${AWS_CLI_DIR}"
      mkdir -p "${AWS_CLI_DIR}"
      curl -fsSL \
        -o "${AWS_CLI_DIR}/awscliv2.zip" \
        "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"
      unzip -q "${AWS_CLI_DIR}/awscliv2.zip" -d "${AWS_CLI_DIR}"
      chmod +x "${AWS_CLI_DIR}/aws/install"
      "${AWS_CLI_DIR}/aws/install" \
        --bin-dir /usr/local/bin \
        --install-dir /usr/local/aws-cli
      rm -rf "${AWS_CLI_DIR}"
    fi

    jq --version
    aws --version

    # Download modules straight into the image layer. werf mounts /go/pkg from the
    # runner host — if GOMODCACHE stays default, nothing is stored in the image and
    # a later `cp -a /go/pkg/mod → /fuzz/gomod` takes forever on fat modules (helm).
    export GOMODCACHE=/fuzz/gomod
    mkdir -p "${GOMODCACHE}"

    # A vendored tree resolves from vendor/ and `go mod download` would fetch a
    # dependency set nothing builds from. Both fork trees vendor; the module's
    # own images do not.
    if [ -f vendor/modules.txt ]; then
      echo "vendored tree, skip go mod download"
    else
      go mod download
    fi

    # Install task without adding it to the imported source module. `go get -tool`
    # followed by `go install tool` mutates the dependency graph and builds every
    # declared upstream tool, which breaks multi-tool modules such as kustomize.
    GOBIN=/usr/local/bin go install github.com/go-task/task/v3/cmd/task@v3.53.1

    echo "Download fuzz corpus overlay from S3"

    # MinIO Client is not used: dl.min.io answers 410 for the client download.
    # AWS CLI is installed above and talks to the same bucket the shared CI
    # template (Build_Fuzz_Images.gitlab-ci.yml) already uses for build reports.
    FUZZ_S3_ENDPOINT="$(cat /run/secrets/FUZZ_S3_ENDPOINT)"

    # The bundled AWS CLI v2 trusts only its own public roots and the fuzz S3
    # endpoint is signed by an internal CA: "certificate verify failed:
    # self-signed certificate in certificate chain". mc used the system store,
    # so point the CLI at it too; the path differs between ALT and Debian bases.
    for ca_bundle in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt; do
      if [ -s "${ca_bundle}" ]; then
        export AWS_CA_BUNDLE="${ca_bundle}"
        break
      fi
    done
    echo "AWS CA bundle: ${AWS_CA_BUNDLE:-<none found, using the AWS CLI default>}"

    fuzz_s3() {
      AWS_ACCESS_KEY_ID="$(cat /run/secrets/FUZZ_S3_ACCESS_KEY)" \
      AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/FUZZ_S3_SECRET_KEY)" \
      aws --endpoint-url "${FUZZ_S3_ENDPOINT}" --region us-east-1 "$@"
    }

    FUZZ_S3_REPOSITORY="$(cat /run/secrets/FUZZ_S3_REPOSITORY)"
    FUZZ_S3_BRANCH_SLUG="$(cat /run/secrets/FUZZ_S3_BRANCH_SLUG)"
    if [ -z "${FUZZ_S3_REPOSITORY}" ] || [ -z "${FUZZ_S3_BRANCH_SLUG}" ]; then
      echo "FUZZ_S3_REPOSITORY and FUZZ_S3_BRANCH_SLUG are required for corpus sync" >&2
      exit 1
    fi

    # s3://anomaloys-materials/<repository>/<branch slug>/<component path>/<s3_key>/
    S3_FUZZING_PATH="s3://anomaloys-materials/${FUZZ_S3_REPOSITORY}/${FUZZ_S3_BRANCH_SLUG}/"
    echo "Corpus S3 path: ${S3_FUZZING_PATH}"
    TMP_CORPUS="/tmp/fuzzing-s3"
    RESTORED_FILES="/tmp/fuzz-restored-files.txt"

    rm -rf "${TMP_CORPUS}"
    mkdir -p "${TMP_CORPUS}"
    : > "${RESTORED_FILES}"

    # An empty prefix makes `aws s3 ls` exit 1 with empty stderr, a real failure
    # (bad credentials, unreachable endpoint) writes to stderr. Empty/missing
    # corpus is normal for a first run; a broken S3 is not — replaying without
    # corpus would pass the build while checking nothing.
    CORPUS_LISTING=/tmp/fuzz-corpus-listing.txt
    CORPUS_LISTING_ERR=/tmp/fuzz-corpus-listing.err
    list_rc=0
    fuzz_s3 s3 ls "${S3_FUZZING_PATH}" > "${CORPUS_LISTING}" 2> "${CORPUS_LISTING_ERR}" || list_rc=$?
    if [ "${list_rc}" -ne 0 ] && [ -s "${CORPUS_LISTING_ERR}" ]; then
      echo "Failed to list fuzz corpus in S3:" >&2
      cat "${CORPUS_LISTING_ERR}" >&2
      exit 1
    fi

    if [ -s "${CORPUS_LISTING}" ]; then
      echo "Fuzz corpus found in S3, download overlay"

      if fuzz_s3 s3 sync "${S3_FUZZING_PATH}" "${TMP_CORPUS}/" --only-show-errors >/dev/null; then
        # A go.work makes plain `go list -m` print every workspace module.
        # Corpus paths contain the current module, so query it with
        # workspace mode disabled while leaving normal test commands untouched.
        MODULE_PATH="$(GOWORK=off go list -m)"
        echo "module path: ${MODULE_PATH}"

        find "${TMP_CORPUS}" \
          -type d \
          -path "*/corpus/gocache-fuzz/${MODULE_PATH}/*" \
          > /tmp/fuzz-target-dirs.txt || true

        restored=0

        while IFS= read -r target_dir; do
          target="$(basename "${target_dir}")"

          case "${target}" in
            Fuzz*) ;;
            *) continue ;;
          esac

          if ! find "${target_dir}" -maxdepth 1 -type f | grep -q .; then
            continue
          fi

          prefix="/corpus/gocache-fuzz/${MODULE_PATH}/"
          case "${target_dir}" in
            *"${prefix}"*) rel="${target_dir##*${prefix}}" ;;
            *) echo "skip: no module prefix in ${target_dir}"; continue ;;
          esac
          # rel is pkg-relative ("pkg/sub" or "" for module root); strip trailing target
          pkg_rel="${rel%"${target}"}"; pkg_rel="${pkg_rel}"
          if [ -n "${pkg_rel}" ]; then
            seed_dir="${pkg_rel}/testdata/fuzz/${target}"
          else
            seed_dir="testdata/fuzz/${target}"
          fi

          echo "restore corpus"
          echo "from: ${target_dir}"
          echo "to: ${seed_dir}"

          mkdir -p "${seed_dir}"

          copied=0

          for corpus_file in "${target_dir}"/*; do
            if [ ! -f "${corpus_file}" ]; then
              continue
            fi

            dst="${seed_dir}/$(basename "${corpus_file}")"

            if [ -e "${dst}" ]; then
              continue
            fi

            cp "${corpus_file}" "${dst}"
            printf '%s\n' "${dst}" >> "${RESTORED_FILES}"

            copied=$((copied + 1))
          done

          echo "copied corpus files for ${target}: ${copied}"
          restored=$((restored + copied))
        done < /tmp/fuzz-target-dirs.txt

        echo "restored corpus files: ${restored}"
        echo "restored file list: ${RESTORED_FILES}"
      else
        echo "Failed to download fuzz corpus overlay, continue without it"
      fi
    else
      echo "No fuzz corpus found in S3 yet, continue without it"
    fi

    echo "Run fuzz replay"
    # Integration trees often need a live cluster and/or private VCS (fox.flant.com)
    # even during package discovery. Drop only known-bad trees before replay.
    for bad in test/e2e tests/e2e tests/ginkgo; do
      if [ -d "${bad}" ]; then
        echo "remove ${bad} before fuzz replay"
        rm -rf "${bad}"
      fi
    done
    git config --global user.name "fuzz"
    git config --global user.email "fuzz@local"
    # Build-time regression replay is intentionally orchestrated here rather than
    # exposed as an extra Taskfile command: Taskfile.fuzz.yml is the platform ABI.
    # Use fuzz:list as the only discovery source, just like fuzzing-compliance.
    export FUZZ_PKGS={{ $fuzzPackages | quote }}
    echo "fuzz discovery scope: ${FUZZ_PKGS}"
    FUZZ_LIST_LOG=/tmp/fuzz-list.log
    FUZZ_TARGETS_FILE=/tmp/fuzz-targets.txt
    list_rc=0
    task fuzz:list > "${FUZZ_LIST_LOG}" 2>&1 || list_rc=$?
    cat "${FUZZ_LIST_LOG}"

    awk '
      /^Fuzz[[:alnum:]_]*$/ { targets[++count] = $0; next }
      /^(ok|FAIL|\?)[[:space:]]+/ {
        package = $2
        for (i = 1; i <= count; i++) print package "|" targets[i]
        delete targets
        count = 0
      }
      END { if (count != 0) exit 2 }
    ' "${FUZZ_LIST_LOG}" > "${FUZZ_TARGETS_FILE}"

    if [ ! -s "${FUZZ_TARGETS_FILE}" ]; then
      echo "fuzz:list returned no Go fuzz targets (rc=${list_rc})" >&2
      exit 1
    fi
    if [ "${list_rc}" -ne 0 ]; then
      echo "fuzz:list exited ${list_rc}, but valid targets were parsed; continue replay"
    fi

    while IFS='|' read -r fuzz_pkg fuzz_target; do
      echo "Replay fuzz corpus: package=${fuzz_pkg} target=${fuzz_target}"
      FUZZ_PKG="${fuzz_pkg}" FUZZ_TARGET="${fuzz_target}" task fuzz:replay
    done < "${FUZZ_TARGETS_FILE}"
    rm -f "${FUZZ_LIST_LOG}" "${FUZZ_TARGETS_FILE}"

    echo "Cleanup restored fuzz corpus"

    if [ -f "${RESTORED_FILES}" ]; then
      while IFS= read -r restored_file; do
        if [ -n "${restored_file}" ] && [ -f "${restored_file}" ]; then
          echo "remove restored corpus file: ${restored_file}"
          rm -f "${restored_file}"
        fi
      done < "${RESTORED_FILES}"
    else
      echo "No restored fuzz corpus file list found, skip cleanup"
    fi

    find . \
      -type d \
      -path "*/testdata/fuzz/Fuzz*" \
      -empty \
      -exec rmdir {} \; 2>/dev/null || true

    find . \
      -type d \
      -path "*/testdata/fuzz" \
      -empty \
      -exec rmdir {} \; 2>/dev/null || true

    rm -rf "${TMP_CORPUS}"
    rm -f /tmp/fuzz-target-dirs.txt
    rm -f "${RESTORED_FILES}"

    go clean -cache -testcache -fuzzcache 2>/dev/null || true

    echo "restored fuzz corpus cleanup done"

    # Non-root k8s: go fuzz writes failing seeds to pkg/testdata/fuzz/<Fuzz*>;
    # coverage-watch syncs GOCACHE there. Root-owned /src → mkdir permission denied → FAIL.
    echo "Make fuzz sources writable for non-root fuzz / testdata"
    chmod -R a+rwX .

    # Modules already live in /fuzz/gomod (image layer). Make readable/writable for non-root.
    chmod -R a+rwX /fuzz/gomod
    rm -f ~/.netrc
{{- end }}
{{- end }}
