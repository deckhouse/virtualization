{{/*
  # Builds $.Images: base image name -> fully qualified pinned reference.
  # Emits no output; reference base images inline as
  # `from: {{ index $.Images "builder/distroless" }}`.
  # Base images come only from the container factory: the legacy
  # deckhouse/base-images library is removed by DKP 1.80.
*/}}
{{- define "parse_base_images_map" }}
{{-   $images := .Files.Get "build/base-images/container_factory_images.yml" | fromYaml }}
{{-   range $k, $v := $images }}
{{-     if ne $k "REGISTRY_PATH" }}
{{-       $_ := set $images $k (printf "%s@%s" $images.REGISTRY_PATH (trimSuffix "/" $v)) }}
{{-     end }}
{{-   end }}
{{-   $_ := unset $images "REGISTRY_PATH" }}
{{-   $_ := set . "Images" $images }}
{{- end }}
