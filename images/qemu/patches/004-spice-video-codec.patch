diff --git a/ui/spice-core.c b/ui/spice-core.c
index 8a6050f..4268394 100644
--- a/ui/spice-core.c
+++ b/ui/spice-core.c
@@ -807,6 +807,18 @@ static void qemu_spice_init(void)
         spice_server_set_streaming_video(spice_server, SPICE_STREAM_VIDEO_OFF);
     }
 
+    /* Pick the encoders for streamed areas, e.g. "gstreamer:vp8;spice:mjpeg".
+     * libspice-server has had spice_server_set_video_codecs() since 0.13.2 and is
+     * linked against gstreamer, but upstream QEMU only wires video-codec in the
+     * local GL path, so a remote SPICE console was stuck with the built-in MJPEG
+     * encoder no matter which plugins the image shipped. The client negotiates the
+     * list, so an encoder it cannot decode is skipped. */
+    str = qemu_opt_get(opts, "video-codec");
+    if (str && spice_server_set_video_codecs(spice_server, str) != 0) {
+        error_report("spice: invalid video-codec: %s", str);
+        exit(1);
+    }
+
     spice_max_refresh_rate = qemu_opt_get_number(opts, "max-refresh-rate",
                                                  DEFAULT_MAX_REFRESH_RATE);
     if (spice_max_refresh_rate <= 0) {
