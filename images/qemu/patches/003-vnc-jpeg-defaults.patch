diff --git a/ui/vnc.c b/ui/vnc.c
--- a/ui/vnc.c
+++ b/ui/vnc.c
@@ -2134,7 +2134,13 @@
     vs->features = 0;
     vs->vnc_encoding = 0;
     vs->tight->compression = 9;
-    vs->tight->quality = -1; /* Lossless by default */
+    /* Default to the same quality level the web console asks for, so clients
+     * that never send a QualityLevel pseudo-encoding are not stuck with
+     * near-raw tiles. gtk-vnc, behind remote-viewer, drops that encoding
+     * unless lossy encoding is enabled and even then only offers level 5.
+     * An explicit level from the client still wins, and none of this has any
+     * effect unless the server runs with lossy=on. */
+    vs->tight->quality = 6;
     vs->absolute = -1;
 
     /*
diff --git a/ui/vnc-enc-tight.c b/ui/vnc-enc-tight.c
--- a/ui/vnc-enc-tight.c
+++ b/ui/vnc-enc-tight.c
@@ -88,9 +88,16 @@
     { 0,   8,  1, 1 },
     { 0,   10, 1, 1 },
     { 0.1, 10, 1, 1 },
-    { 0.2, 10, 1, 1 },
-    { 0.3, 12, 0, 0 },
-    { 0.4, 14, 0, 0 },
+    /* Levels 5 to 7 are treated as "JPEG at quality 50/60/70" rather than
+     * "lossless", because a console that goes through several hops with TLS
+     * cannot afford lossless: it costs 719 KiB per frame and 38 fps on a
+     * 1280x800 desktop against 64 KiB and 141 fps. Levels 8 and 9 keep the
+     * upstream meaning and stay lossless for clients that demand it. The
+     * frequency floor is lowered because plain window dragging did not reach
+     * the original 0.2 threshold, so JPEG never engaged at level 5. */
+    { 0.1, 10, 1, 1 },
+    { 0.1, 12, 1, 1 },
+    { 0.1, 14, 1, 1 },
     { 0.5, 16, 0, 0 },
 };
 #endif
