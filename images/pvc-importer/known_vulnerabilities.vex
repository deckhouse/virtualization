      },
      "products": [
        {
          "@id": "pkg:golang/github.com/docker/distribution@v2.8.3%2Bincompatible"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_present",
      "impact_statement": "CVE-2026-85747 относится к пакету github.com/docker/distribution/registry/client: метод manifests.Get не сверяет полученный manifest с запрошенным digest, а pull-through proxy registry/proxy кеширует такой manifest. Модуль github.com/docker/distribution (v2) архивирован, исправленной версии нет. В образе pvc-importer модуль присутствует как транзитивная зависимость (github.com/containers/image/v5/docker); в бинарные файлы usr/bin/pvc-importer, usr/bin/pvc-target-importer из него попадают только пакеты registry/api/errcode, registry/api/v2, registry/client/auth/challenge. Пакеты registry/client и registry/proxy в бинарные файлы образа не входят, поэтому уязвимость для образа не достижима.",
      "timestamp": "2026-10-19T00:00:00Z"
    }
  ],
  "timestamp": "2026-10-19T00:00:00Z",
  "last_updated": "2026-10-19T00:00:00Z"
