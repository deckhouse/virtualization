{
  "@context": "https://openvex.dev/ns/v0.2.0",
  "@id": "https://openvex.dev/docs/public/vex-virtualization-bundle-go-2026-5932",
  "author": "Deckhouse <contact@deckhouse.io>",
  "version": 2,
  "statements": [
    {
      "vulnerability": {
        "name": "GO-2026-5932"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.55.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "GO-2026-5932 относится к пакету golang.org/x/crypto/openpgp, который является unmaintained и не имеет исправленной версии. В module-образе пакет openpgp присутствует исключительно как транзитивная зависимость модуля golang.org/x/crypto в бинарном файле hooks/go/virtualization-module-hooks; hook не использует OpenPGP-функциональность. Код openpgp не входит в путь исполнения, поэтому уязвимость для образа не достижима.",
      "timestamp": "2026-07-13T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-56855"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.55.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "CVE-2026-56855 относится к пакету golang.org/x/crypto/ssh (обработка SSH-каналов после установления соединения). Бинарный файл hooks/go/virtualization-module-hooks не импортирует golang.org/x/crypto/ssh: из модуля golang.org/x/crypto линкуются только другие пакеты (bcrypt, ed25519, cryptobyte, ocsp, pkcs12 и т.п.), SSH-подпакет в образ не попадает. Hook не выступает ни SSH-сервером, ни SSH-клиентом. Уязвимый код не входит в путь исполнения, поэтому уязвимость для образа не достижима.",
      "timestamp": "2026-09-07T00:00:00Z"
    },
    {
      "vulnerability": {
        "name": "CVE-2026-78662"
      },
      "products": [
        {
          "@id": "pkg:golang/golang.org/x/crypto@v0.55.0"
        }
      ],
      "status": "not_affected",
      "justification": "vulnerable_code_not_in_execute_path",
      "impact_statement": "CVE-2026-78662 относится к пакету golang.org/x/crypto/ssh (обработка канала, зарегистрированного в mux chanList). Бинарный файл hooks/go/virtualization-module-hooks не импортирует golang.org/x/crypto/ssh: из модуля golang.org/x/crypto линкуются только другие пакеты (bcrypt, ed25519, cryptobyte, ocsp, pkcs12 и т.п.), SSH-подпакет в образ не попадает. Hook не выступает ни SSH-сервером, ни SSH-клиентом. Уязвимый код не входит в путь исполнения, поэтому уязвимость для образа не достижима.",
      "timestamp": "2026-09-07T00:00:00Z"
    }
  ],
  "timestamp": "2026-07-13T00:00:00Z",
  "last_updated": "2026-09-07T00:00:00Z"
}
