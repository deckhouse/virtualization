namespace: ${NAMESPACE}
storageType: ${STORAGE_TYPE}
storageClass: ${DEFAULT_STORAGE_CLASS}
sa: dkp-sa
enabledModules: [${ENABLED_MODULES}]
deckhouse:
  channel: ${DECKHOUSE_CHANNEL}
  version: ${DECKHOUSE_VERSION}
  podSubnetCIDR: ${POD_SUBNET_CIDR}
  serviceSubnetCIDR: ${SERVICE_SUBNET_CIDR}
  kubernetesVersion: ${K8S_VERSION}
  registry: ${REGISTRY}
  registryDockerCfg: ${REGISTRY_DOCKER_CFG}
  bundle: Default
  proxyEnabled: false
image:
  url: ${VIRTUALIZATION_IMAGE_URL}
  defaultUser: ${DEFAULT_USER}
  bootloader: BIOS
# Nodes of the nested cluster are virtual machines, and their virtual CPU carries
# no invariant TSC, so virt-handler never labels them with a TSC frequency.
# Without that label virt-controller refuses to create a virt-launcher pod for a
# VM that needs TSC topology hints - a Windows-osType VM turns on HyperV
# reenlightenment and needs them - so such a VM never starts. Advertise the TSC
# frequency of the underlying hardware on every node of the nested cluster to
# make those VMs runnable.
#
# The frequency has to be the one the nodes really run at, in Hz - read it from
# "cpu MHz" in /proc/cpuinfo, or from the "tsc: Detected ... MHz processor" line
# of dmesg. KVM cannot scale the frequency here: it accepts a request above the
# real one and compensates in software, but rejects a request below it and the
# VM then fails to start. Nodes differ by a few dozen kHz, so take the highest
# of them.
nodeCPUTimerLabels:
  cpu-timer.node.virtualization.deckhouse.io/tsc-frequency: "4192216000"
  cpu-timer.node.virtualization.deckhouse.io/tsc-scalable: "true"
ingressHosts:
  - api
  - grafana
  - dex
  - prometheus
  - console
  - virtualization
instances:
  aptMirror:
    enabled: ${APT_MIRROR_ENABLED}
    name: ${APT_MIRROR_NAME}
    url: ${APT_MIRROR_URL}
  masterNodes:
    count: 1
    cfg:
      rootDiskSize: 60Gi
      cpu:
        cores: 4
        coreFraction: 50%
      memory:
        size: 12Gi
  additionalNodes:
    - name: worker
      count: 3
      cfg:
        cpu:
          cores: 6
          coreFraction: 50%
        memory:
          size: ${CLUSTER_CONFIG_WORKERS_MEMORY}
        additionalDisks:
          - size: ${ADDITIONAL_DISK_SIZE}
  networkConfig:
    clusterNetworkName: ${NESTED_CLUSTER_NETWORK_NAME}
